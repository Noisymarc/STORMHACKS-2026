# Copy this file to .env in the repository root and enter your own keys.
# .env is ignored by Git. Never put real credentials in this example.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: Gemini check of related glossary matches (see README).
# CONCEPT_JUDGE=off
# CONCEPT_JUDGE_PER_MINUTE=4
# CONCEPT_JUDGE_DAILY_LIMIT=150

# Optional: needed only for the separate TiDB module.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB_NAME=test
TIDB_CA_PATH=
