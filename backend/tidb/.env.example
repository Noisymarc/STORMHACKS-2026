# Copy to the repo root as .env (already git-ignored).
# Values from TiDB Cloud console -> your Starter cluster (AWS region) -> Connect.
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=
TIDB_DB_NAME=test
# Optional: CA bundle path if the system CAs are not found
# TIDB_CA_PATH=/etc/ssl/certs/ca-certificates.crt
